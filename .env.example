# Base URL of your Twenty CRM (no trailing slash)
TWENTY_URL=https://crm.example.com
# Twenty API key (Settings -> APIs & Webhooks). Needs create access on Lead and Lead Course, read on Course.
TWENTY_API_KEY=

# WordPress REST API base URL for the Blog (no trailing slash)
# Example: https://blog.erasight.vn/wp-json/wp/v2
# The server will proxy /api/wp/* -> WP_API_URL/* to avoid CORS issues.
WP_API_URL=

# Only WordPress posts with this tag appear on the Blog pages (tag slug or name, e.g. erasight-education).
# Default: erasight-education
WP_POST_TAG=erasight-education

# Public URL this site is served from (no trailing slash). Used for canonical links,
# Open Graph/Twitter Card URLs, and sitemap.xml generation.
SITE_URL=https://academy.erasight.net

# Google Tag Manager container id (e.g. GTM-ABC1234). Leave empty for no Google tags.
# The container loads only after a visitor accepts "Đo lường nguồn truy cập" in the cookie banner.
# Before enabling, update the privacy policy (it currently says no data goes to third-party analytics).
GTM_ID=

# --- AI document library (/tai-lieu-ai and admin at /tai-lieu-ai-admin) ---
# Admin password for /tai-lieu-ai-admin. Use a long random value. Leave empty to disable the admin area.
ADMIN_PASSWORD=
# Secret used to sign the admin session and the visitors' download-access cookies.
# Set a fixed random value (e.g. `openssl rand -hex 32`) so cookies survive restarts.
SESSION_SECRET=
# Secret the Twenty workflow sends in the X-API-Key header to fetch the scheduled event emails that are due
# (POST /api/workflow/due-emails). Use a long random value, e.g.: openssl rand -hex 32
WORKFLOW_API_KEY=
# Max emails handed to the Twenty workflow per run (it runs every ~15 min). Gmail allows ~500/day.
MAIL_BATCH_MAX=50
# Optional: staff who get one copy of every seeding / notification email, for all events (comma-separated)
INTERNAL_COPY_EMAILS=
# Delivery confirmation: 1 = a mail only counts as sent once the Twenty workflow confirms it (needs the "Confirm sent" step); unconfirmed ones retry after MAIL_CLAIM_TTL_MIN (30) up to MAIL_MAX_ATTEMPTS (3) times
MAIL_REQUIRE_CONFIRM=0
# How many days a visitor can download documents after filling the form (default 7).
ACCESS_DAYS=7
# Upload size limits in MB (documents / cover images).
MAX_DOC_MB=25
MAX_COVER_MB=3
# Optional: enables the admin MCP server at /mcp (events + scheduled emails). Use a long random secret (>= 24 chars), e.g. `openssl rand -hex 32`
MCP_TOKEN=
