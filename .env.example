# Base URL of your Twenty CRM (no trailing slash)
TWENTY_URL=https://crm.example.com
# Twenty API key (Settings -> APIs & Webhooks). Needs create access on Lead and Lead Course, read on Course.
TWENTY_API_KEY=

# WordPress REST API base URL for the Blog (no trailing slash)
# Example: https://blog.erasight.vn/wp-json/wp/v2
# The server will proxy /api/wp/* -> WP_API_URL/* to avoid CORS issues.
WP_API_URL=

# Only WordPress posts with this tag appear on the Blog pages (tag slug or name, e.g. erasight-education).
# Default: erasight-education
WP_POST_TAG=erasight-education

# Public URL this site is served from (no trailing slash). Used for canonical links,
# Open Graph/Twitter Card URLs, and sitemap.xml generation.
SITE_URL=https://academy.erasight.net

# --- AI document library (/tai-lieu-ai and admin at /tai-lieu-ai-admin) ---
# Admin password for /tai-lieu-ai-admin. Use a long random value. Leave empty to disable the admin area.
ADMIN_PASSWORD=
# Secret used to sign the admin session and the visitors' download-access cookies.
# Set a fixed random value (e.g. `openssl rand -hex 32`) so cookies survive restarts.
SESSION_SECRET=
# How many days a visitor can download documents after filling the form (default 7).
ACCESS_DAYS=7
# Upload size limits in MB (documents / cover images).
MAX_DOC_MB=25
MAX_COVER_MB=3
